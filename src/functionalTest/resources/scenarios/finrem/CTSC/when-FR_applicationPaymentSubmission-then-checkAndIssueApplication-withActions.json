{
  "description": "DFR-4603: When FR_applicationPaymentSubmission is run then the checkAndIssueApplication task is created.",
  "enabled": true,
  "jurisdiction": "DIVORCE",
  "caseType": "FinancialRemedyMVP2",
  "options": {
    "taskRetrievalApi": "task-management-api"
  },
  "required": {
    "credentials": {
      "key": "systemupdate"
    },
    "ccd": [
      {
        "eventId": "FR_newPaperCase",
        "caseData": {
          "template": "minimal-finrem.json",
          "replacements": {
          }
        }
      }
    ]
  },
  "before": {
    "request": {
      "credentials": {
        "key": "CTSC-Administrator"
      },
      "input": {
        "eventMessages": [
          {
            "destination": "RestEndpoint",
            "template": "minimal-ccd-event-message-finrem.json",
            "replacements": {
              "EventId": "FR_applicationPaymentSubmission",
              "NewStateId": "applicationSubmitted",
              "AdditionalData": {
                "Data": {
                  "evidenceHandled": "No"
                }
              }
            }
          }
        ]
      }
    },
    "expectations": [
      {
        "credentials": {
          "key": "CTSC-Administrator"
        },
        "status": 200,
        "numberOfTasksAvailable": 1,
        "taskData": {
          "template": "minimal-task-response-finrem.json",
          "replacements": {
            "tasks": [
              {
                "test_meta_data": [
                  {
                    "key": "role_data_reference",
                    "value": "checkApplication"
                  }
                ],
                "type": "checkApplication",
                "name": "Check and Issue Application",
                "minor_priority": 500,
                "major_priority": 5000,
                "description": "[Issue Application](/cases/case-details/${[CASE_REFERENCE]}/trigger/FR_issueApplication/FR_issueApplication1)"
              }
            ]
          }
        },
        "roleData": [
          {
            "key": "checkApplication",
            "numberOfRolesAvailable": 2,
            "roles": [
              {
                "role_category": "CTSC",
                "role_name": "ctsc",
                "permissions": [
                  "Read",
                  "Own",
                  "Execute",
                  "CompleteOwn",
                  "CancelOwn",
                  "Claim"
                ],
                "authorisations": [
                  "SKILL:ABA2:CheckingApplications"
                ]
              },
              {
                "role_category": "CTSC",
                "role_name": "ctsc-team-leader",
                "permissions": [
                  "Read",
                  "Own",
                  "Manage",
                  "Execute",
                  "Cancel",
                  "Complete",
                  "Claim",
                  "Unclaim",
                  "Assign",
                  "Unassign"
                ],
                "authorisations": [
                  "SKILL:ABA2:CheckingApplications"
                ]
              }
            ]
          },
          {
            "key": "checkAndIssueApplication",
            "numberOfRolesAvailable": 2,
            "roles": [
              {
                "role_category": "CTSC",
                "role_name": "ctsc",
                "permissions": [
                  "Read",
                  "Own",
                  "Execute",
                  "CompleteOwn",
                  "CancelOwn",
                  "Claim"
                ],
                "authorisations": [
                  "SKILL:ABA2:CheckingApplications"
                ]
              },
              {
                "role_category": "CTSC",
                "role_name": "ctsc-team-leader",
                "permissions": [
                  "Read",
                  "Own",
                  "Manage",
                  "Execute",
                  "Cancel",
                  "Complete",
                  "Claim",
                  "Unclaim",
                  "Assign",
                  "Unassign"
                ],
                "authorisations": [
                  "SKILL:ABA2:CheckingApplications"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "request": {
        "type": "CLAIM",
        "credentials": {
          "key": "CTSC-Administrator",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "ctsc-team-leader",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 1,
          "taskData": {
            "template": "minimal-task-response-finrem.json",
            "replacements": {
              "tasks": [
                {
                  "task_state": "assigned",
                  "task_system": "SELF",
                  "test_meta_data": [
                    {
                      "key": "role_data_reference",
                      "value": "checkApplication"
                    }
                  ],
                  "assignee": "{$ASSIGNEE_ID}",
                  "type": "checkApplication",
                  "name": "Check and Issue Application",
                  "minor_priority": 500,
                  "major_priority": 5000,
                  "description": "[Issue Application](/cases/case-details/${[CASE_REFERENCE]}/trigger/FR_issueApplication/FR_issueApplication1)"
                }
              ]
            }
          }
        },
        {
          "request": {
            "type": "COMPLETE",
            "credentials": {
              "key": "team-leader",
              "granularPermission": true
            }
          },
          "expectations": [
            {
              "credentials": {
                "key": "CTSC-Administrator",
                "granularPermission": true
              },
              "status": 200,
              "numberOfTasksAvailable": 0
            }
          ]
        }
      ]
    }
  ]
}


