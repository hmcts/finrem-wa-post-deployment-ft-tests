{
  "description": "DFR-4600: When FR_close is run, then any tasks on the case are cancelled",
  "enabled": true,
  "jurisdiction": "DIVORCE",
  "caseType": "FinancialRemedyMVP2",
  "options": {
    "taskRetrievalApi": "task-management-api"
  },
  "required": {
    "credentials": {
      "key": "systemupdate"
    },
    "ccd": [
      {
        "eventId": "FR_newPaperCase",
        "caseData": {
          "template": "minimal-finrem.json",
          "replacements": {
          }
        }
      }
    ]
  },
  "tests": [
    {
      "request": {
        "credentials": {
          "key": "CTSC-Administrator"
        },
        "input": {
          "eventMessages": [
            {
              "destination": "RestEndpoint",
              "template": "minimal-ccd-event-message-finrem.json",
              "replacements": {
                "EventId": "attachScannedDocs",
                "NewStateId": "FR_newPaperCase"
              }
            }
          ]
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "ctsc-team-leader"
          },
          "status": 200,
          "numberOfTasksAvailable": 1,
          "taskData": {
            "template": "minimal-task-response-finrem.json",
            "replacements": {
              "tasks": [
                {
                  "task_state": "unassigned",
                  "task_system": "SELF",
                  "test_meta_data": [
                    {
                      "key": "role_data_reference",
                      "value": "processScannedDocuments"
                    }
                  ],
                  "type": "processScannedDocuments",
                  "name": "Process Scanned Documents",
                  "description": "[Attach scanned document](/cases/case-details/${[CASE_REFERENCE]}/trigger/attachScannedDocs/attachScannedDocs1)",
                  "task_title" : "Process Scanned Documents",
                  "jurisdiction" : "DIVORCE",
                  "case_category" : "FR Consented",
                  "case_name" : "Baggins vs Gollum",
                  "case_management_category" : "FR Consented",
                  "work_type_id" : "evidence",
                  "role_category" : "CTSC",
                  "case_type_id" : "FinancialRemedyMVP2"
                }
              ]
            }
          },
          "roleData": [
            {
              "key": "processScannedDocuments",
              "numberOfRolesAvailable": 2,
              "roles": [
                {
                  "role_category": "CTSC",
                  "role_name": "ctsc",
                  "permissions": [
                    "Read",
                    "Own",
                    "Execute",
                    "CompleteOwn",
                    "CancelOwn",
                    "Claim"
                  ],
                  "authorisations": [
                    "SKILL:ABA2:ManageScannedDocuments"
                  ]
                },
                {
                  "role_category": "CTSC",
                  "role_name": "ctsc-team-leader",
                  "permissions": [
                    "Read",
                    "Own",
                    "Manage",
                    "Execute",
                    "Cancel",
                    "Complete",
                    "Claim",
                    "Unclaim",
                    "Assign",
                    "Unassign"
                  ],
                  "authorisations": [
                    "SKILL:ABA2:ManageScannedDocuments"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "request": {
        "credentials": {
          "key": "CTSC-Administrator"
        },
        "input": {
          "eventMessages": [
            {
              "destination": "RestEndpoint",
              "template": "minimal-ccd-event-message-finrem.json",
              "replacements": {
                "EventId": "FR_close",
                "NewStateId": "close"
              }
            }
          ]
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "ctsc-team-leader",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 0
        }
      ]
    }
  ]
}
