{
  "description": "DFR-4606: When FR_orderRefusal is run and hearing to be listed or manual refusal reason entered is true, then the reviewRefusedOrder task is created, claimed and completed",
  "enabled": true,
  "jurisdiction": "DIVORCE",
  "caseType": "FinancialRemedyMVP2",
  "options": {
    "taskRetrievalApi": "task-management-api"
  },
  "required": {
    "credentials": {
      "key": "systemupdate"
    },
    "ccd": [
      {
        "eventId": "FR_newPaperCase",
        "caseData": {
          "template": "minimal-finrem.json",
          "replacements": {
          }
        }
      }
    ]
  },
  "tests": [
    {
      "request": {
        "credentials": {
          "key": "CTSC-Administrator"
        },
        "input": {
          "eventMessages": [
            {
              "destination": "RestEndpoint",
              "template": "minimal-ccd-event-message-finrem.json",
              "replacements": {
                "EventId": "FR_orderRefusal",
                "NewStateId": "orderMade",
                "AdditionalData": {
                  "Data":
                  {
                    "orderRefusalCollection" : [
                      {
                        "value" : {
                          "orderRefusalAfterText" : "testAfterText",
                          "orderRefusal" : [
                            "Hearing fixed for first available date"
                          ],
                          "orderRefusalOther" : "test1",
                          "orderRefusalDocs" : {
                            "document_url" : "http://doc1",
                            "document_filename" : "doc1",
                            "document_binary_url" : "http://doc1.binary"
                          },
                          "orderRefusalJudgeName" : "test3",
                          "orderRefusalDate" : "2003-02-01",
                          "orderRefusalAddComments" : "comment1",
                          "orderRefusalJudge" : "District Judge"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "ctsc-team-leader"
          },
          "status": 200,
          "numberOfTasksAvailable": 1,
          "taskData": {
            "template": "minimal-task-response-finrem.json",
            "replacements": {
              "tasks": [
                {
                  "task_state": "unassigned",
                  "task_system": "SELF",
                  "test_meta_data": [
                    {
                      "key": "role_data_reference",
                      "value": "reviewRefusedOrder"
                    }
                  ],
                  "type": "reviewRefusedOrder",
                  "name": "Review Refused Order",
                  "description": "[List For Hearing](/cases/case-details/${[CASE_REFERENCE]}/trigger/FR_listForHearing/FR_listForHearing1)",
                  "task_title" : "Review Refused Order",
                  "jurisdiction" : "DIVORCE",
                  "case_category" : "FR Consented",
                  "case_name" : "Baggins vs Gollum",
                  "case_management_category" : "FR Consented",
                  "work_type_id" : "hearing_work",
                  "role_category" : "CTSC",
                  "case_type_id" : "FinancialRemedyMVP2"
                }
              ]
            }
          },
          "roleData": [
            {
              "key": "reviewRefusedOrder",
              "numberOfRolesAvailable": 2,
              "roles": [
                {
                  "role_category": "CTSC",
                  "role_name": "ctsc",
                  "permissions": [
                    "Read",
                    "Own",
                    "Execute",
                    "CompleteOwn",
                    "CancelOwn",
                    "Claim"
                  ],
                  "authorisations": [
                    "SKILL:ABA2:CheckRefusedOrder"
                  ]
                },
                {
                  "role_category": "CTSC",
                  "role_name": "ctsc-team-leader",
                  "permissions": [
                    "Read",
                    "Own",
                    "Manage",
                    "Execute",
                    "Cancel",
                    "Complete",
                    "Claim",
                    "Unclaim",
                    "Assign",
                    "Unassign"
                  ],
                  "authorisations": [
                    "SKILL:ABA2:CheckRefusedOrder"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "request": {
        "type": "CLAIM",
        "credentials": {
          "key": "CTSC-Administrator",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "ctsc-team-leader",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 1,
          "taskData": {
            "template": "minimal-task-response-finrem.json",
            "replacements": {
              "tasks": [
                {
                  "task_state": "assigned",
                  "task_system": "SELF",
                  "test_meta_data": [
                    {
                      "key": "role_data_reference",
                      "value": "reviewRefusedOrder"
                    }
                  ],
                  "assignee": "{$ASSIGNEE_ID}",
                  "type": "reviewRefusedOrder",
                  "name": "Review Refused Order",
                  "description": "[List For Hearing](/cases/case-details/${[CASE_REFERENCE]}/trigger/FR_listForHearing/FR_listForHearing1)"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "request": {
        "type": "COMPLETE",
        "credentials": {
          "key": "ctsc-team-leader",
          "granularPermission": true
        }
      },
      "expectations": [
        {
          "credentials": {
            "key": "CTSC-Administrator",
            "granularPermission": true
          },
          "status": 200,
          "numberOfTasksAvailable": 0
        }
      ]
    }
  ]
}
